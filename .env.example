# Copy to .env and fill in. On Render, set these in the dashboard instead
# (Environment tab) — never commit real secrets.
VERA_LLM_PROVIDER=gemini
VERA_LLM_MODEL=gemini-flash-lite-latest
VERA_LLM_API_KEY=your-key-here
VERA_LLM_TIMEOUT=6.5

VERA_TEAM_NAME=Your Team Name
VERA_TEAM_MEMBERS=Member One,Member Two
VERA_CONTACT_EMAIL=you@example.com
VERA_VERSION=1.0.0
VERA_SUBMITTED_AT=2026-09-28T09:00:00Z
